{
  "name": "anhnguyet-golive",
  "displayName": "Ánh Nguyệt Go Live",
  "description": "Chuẩn bị Backend và khởi chạy website Ánh Nguyệt bằng một nút.",
  "version": "1.2.2",
  "publisher": "anhnguyet-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anhnguyet.goLive",
        "title": "Go Live Ánh Nguyệt",
        "category": "Ánh Nguyệt"
      },
      {
        "command": "anhnguyet.stopOwnedBackend",
        "title": "Dừng dịch vụ Ánh Nguyệt",
        "category": "Ánh Nguyệt"
      }
    ]
  }
}


