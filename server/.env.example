# Sao chép thành .env trên máy cục bộ và thay các giá trị ví dụ.
# Không commit file .env hoặc chia sẻ mật khẩu/JWT secret.
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=anh_nguyet_app
DB_PASSWORD=CHANGE_ME
DB_NAME=anh_nguyet
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Origin tuyệt đối của giao diện, không thêm đường dẫn thư mục hay dấu gạch cuối.
# Bắt buộc để tạo liên kết mời Nhân viên.
FRONTEND_BASE_URL=https://example.com

# Để trống SMTP_HOST nếu dùng Gmail SMTP bên dưới.
# Nếu dùng máy chủ SMTP khác, điền host/port/secure/from và cặp user/password (nếu cần).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Chỉ cần cấu hình nếu dùng Gmail SMTP (mặc định khi SMTP_HOST để trống).
GMAIL_USER=
GMAIL_APP_PASSWORD=
